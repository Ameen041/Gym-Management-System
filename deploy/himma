#!/usr/bin/env bash
# Everyday commands for the Himma server (setup.sh installs this as /usr/local/bin/himma).
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKUPS=/root/himma-backups
compose() { docker compose --project-directory "$DIR" -f "$DIR/compose.yml" "$@"; }

case "${1:-help}" in
  update)
    # newest version from GitHub, then rebuild; the data stays in its volumes
    git -C "$DIR/.." pull --ff-only
    compose up -d --build
    docker image prune -f >/dev/null
    echo "Updated. Check with: himma status"
    ;;
  status)
    compose ps
    ;;
  logs)
    compose logs -f --tail=100 "${2:-app}"
    ;;
  restart)
    # recreates the containers, so changes to deploy/.env are picked up
    compose up -d --force-recreate
    ;;
  stop)
    compose stop
    ;;
  start)
    compose up -d
    ;;
  backup)
    compose exec -T app php artisan app:backup
    install -d -m 700 "$BACKUPS"
    compose cp app:/var/www/html/storage/app/backups/. "$BACKUPS/"
    chmod 600 "$BACKUPS"/*   # they hold everyone's data
    # shellcheck disable=SC2012 # backup names are plain (himma-date-time.json.gz)
    latest="$(ls -t "$BACKUPS" | head -1)"
    echo
    echo "Backups are in $BACKUPS. To copy the newest to your computer, run this on the computer:"
    echo "  scp root@$(hostname -I | awk '{ print $1 }'):$BACKUPS/$latest ."
    ;;
  artisan)
    shift
    compose exec app php artisan "$@"
    ;;
  shell)
    compose exec app bash
    ;;
  *)
    cat <<'EOF'
himma update    get the newest version from GitHub and restart (data is kept)
himma status    is everything running?
himma logs      what the app is writing (himma logs caddy / himma logs db for the others; Ctrl+C stops)
himma backup    make a backup now and copy all backups to /root/himma-backups
himma restart   restart, picking up changes in deploy/.env
himma stop | start
himma artisan   run a Laravel command, e.g. himma artisan about
himma shell     a terminal inside the app
EOF
    ;;
esac
