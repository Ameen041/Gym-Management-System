# Himma - settings for the live site.
# Copy the values into your host's environment settings (Render: Environment tab),
# or into a .env file on the server. Never commit the real values.

APP_NAME="Himma"
APP_ENV=production
APP_DEBUG=false
# generate once with: php artisan key:generate --show
APP_KEY=
# the full https address of the site
APP_URL=https://example.com

# First admin account (created on the first start, never overwritten afterwards).
# The password must be at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database (MySQL shown; PostgreSQL: DB_CONNECTION=pgsql, port 5432)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Email for password reset links (any SMTP service, e.g. Brevo or Gmail with an app password).
# Until this is set, use "Reset link" on Admin -> Users and send it on WhatsApp.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Himma"

LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
